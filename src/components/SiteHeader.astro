---
import { site } from '../config/site';

const path = Astro.url.pathname;

const items = [
  { href: '/airports/', label: '机场资料' },
  { href: '/guides/', label: '选购指南' },
  { href: '/reviews/', label: '评析' },
  { href: '/compare/', label: '对比' },
  { href: '/about/', label: '关于' },
  { href: '/search/', label: '搜索' },
];

const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/"><span class="brand__mark" aria-hidden="true"></span>{site.name}</a>
    <nav class="nav-desktop" aria-label="主导航">
      <ul class="nav-links">
        {items.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    {/* “搜索”旁的社交图标（站长 2026-11-06 要求）：GitHub 等 site.github 填上链接后才显示。 */}
    <div class="nav-social">
      <a class="social-link" href={site.telegram} target="_blank" rel="noopener" aria-label="机场梦 Telegram（新窗口打开）" title="Telegram">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="tg-header-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2AABEE" />
              <stop offset="1" stop-color="#229ED9" />
            </linearGradient>
          </defs>
          <circle cx="12" cy="12" r="12" fill="url(#tg-header-fill)" />
          <path fill="#fff" d="M16.906 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
        </svg>
      </a>
      {
        site.github && (
          <a class="social-link" href={site.github} target="_blank" rel="noopener" aria-label="机场梦 GitHub（新窗口打开）" title="GitHub">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5z" />
            </svg>
          </a>
        )
      }
    </div>
    <details class="nav-menu">
      <summary>菜单</summary>
      <nav aria-label="移动端导航">
        <ul class="nav-links">
          {items.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // 点击链接后收起移动菜单，避免遮挡目标内容。
  document.querySelector('.nav-menu')?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      document.querySelector<HTMLDetailsElement>('.nav-menu')!.open = false;
    }
  });
</script>
