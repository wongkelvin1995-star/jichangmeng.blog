---
import Base from '../../layouts/Base.astro';
import ArticleEntry from '../../components/ArticleEntry.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedGuides } from '../../lib/airports';
import { GUIDE_GROUPS, KIND_LABEL } from '../../lib/content';
import { breadcrumbJsonLd, collectionJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getPublishedGuides();
  if (guides.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { entry: null, guides } },
    ...guides.map((entry) => ({ params: { slug: entry.id }, props: { entry, guides } })),
  ];
}

const { entry, guides } = Astro.props;
const crumbs = [{ label: '首页', href: '/' }, { label: '选购指南' }];
const description = '从付款方式、流量规则、客户端排查到测速记录，逐项解决机场选购和使用问题，并说明每个结论成立的条件。';
const groups = GUIDE_GROUPS.map((name) => ({ name, items: guides.filter((guide) => guide.data.category === name) })).filter((group) => group.items.length > 0);
---

{
  entry ? (
    <ArticleEntry entry={entry} section={{ label: '选购指南', href: '/guides/' }} kindLabel={entry.data.category === '新手入门' ? '新手教程' : KIND_LABEL.guide} />
  ) : (
    <Base
      title="机场选购与使用指南｜付款、流量、客户端与测速｜机场梦"
      description={description}
      jsonLd={[
        breadcrumbJsonLd(crumbs),
        collectionJsonLd({ name: '机场选购与使用指南', description, path: '/guides/', items: guides.map((guide) => ({ name: guide.data.title, path: `/guides/${guide.id}/` })) }),
      ]}
    >
      <div class="wrap">
        <header class="page-head">
          <Breadcrumbs items={crumbs} />
          <h1>机场选购与使用指南</h1>
          <p>从付款、流量到客户端和测试方法，逐项解决选择和使用问题。</p>
        </header>
        {groups.map((group) => (
          <section class="section section--tight">
            <h2 class="group-title">{group.name}</h2>
            <div class="choose-grid">
              {group.items.map((guide) => (
                <article class="choose">
                  <h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
                  <p>{guide.data.description}</p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </Base>
  )
}
