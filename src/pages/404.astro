---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在｜机场梦" description="你访问的页面不存在。" noindex>
  <div class="wrap">
    <section class="section" style="text-align:center;padding-block:96px">
      <p class="section__kicker">404</p>
      <h1 style="font-size:32px">这段航线不存在</h1>
      <p class="section__sub" style="margin-inline:auto">页面可能已经移动，或者地址输入有误。</p>
      <div class="hero__actions" style="justify-content:center">
        <a class="btn btn--primary" href="/">回到首页</a>
        <a class="btn" href="/airports/">查看机场目录</a>
      </div>
    </section>
  </div>
</Base>
