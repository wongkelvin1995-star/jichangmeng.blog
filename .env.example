# 正式域名、IndexNow 密钥和 Bing 验证值都写在 site.config.json。
# 下面的环境变量只在需要覆盖时使用，平时不用设置。
# 开放索引用 npm run build:production，默认的 npm run build 是 noindex 的预览版本。

# 覆盖正式域名，例如 https://jichangmeng.blog
SITE_ORIGIN=

# 覆盖 Bing Webmaster Tools 的 HTML meta 验证值（msvalidate.01）
BING_SITE_VERIFICATION=

# 覆盖 IndexNow 密钥（8–128 位字母、数字或连字符）
INDEXNOW_KEY=
